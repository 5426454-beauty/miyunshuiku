# 高德地图 Web JS API Key（必填）
# 申请地址：https://lbs.amap.com/api/javascript-api-v2/guide/abc/prepare
AMAP_KEY=your_amap_key_here

# 高德安全密钥（如启用了域名白名单则必填，否则留空）
AMAP_SECURITY_CODE=

# ============================================================
# LLM 配置（二选一）
# ============================================================

# 方案一：OpenRouter（推荐，无 RPM/TPM 硬限制，支持高并发）
# 申请地址：https://openrouter.ai/keys
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_API_KEY=sk-or-v1-your-openrouter-key-here
# 可选模型：qwen/qwen3-vl-30b-a3b-instruct / qwen/qwen-vl-max / qwen/qwen2.5-vl-72b-instruct
QWEN_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# 方案二：阿里云百炼 DashScope（有 RPM=60/TPM=100K 硬限制）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=sk-your-dashscope-key-here
# QWEN_MODEL=qwen3-vl-plus

# 服务端口（Playwright 也从这个端口加载地图页面）
SERVER_PORT=8000

# 智能体最大执行步数
MAX_STEPS=20

# 区域遍历并行 Worker 数（每个 Worker 一个独立浏览器实例）
# 推荐 3-5，取决于机器内存和 API QPM 限制
TRAVERSE_WORKERS=5
